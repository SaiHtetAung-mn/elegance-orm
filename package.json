{
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.10.5",
    "@types/sqlite3": "^3.1.11",
    "mocha": "^10.4.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0"
  },
  "name": "elegance-orm",
  "description": "A minimalist Object Relational Mapping library for NodeJs",
  "version": "0.1.0-beta.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "elegance": "dist/console/cli.js",
    "elegance-orm": "dist/console/cli.js"
  },
  "dependencies": {
    "mysql2": "^3.10.2",
    "pg": "^8.11.5",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "test": "mocha -r ts-node/register -r tsconfig-paths/register \"tests/**/*.test.ts\"",
    "elegance": "ts-node -r tsconfig-paths/register src/console/cli.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && tsc-alias -p tsconfig.json && cp -R src/migration/stubs dist/migration/"
  },
